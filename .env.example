# =============================================================================
# SureStep Backend — Environment Variables Template
# Copy to .env and fill in real values. DO NOT commit .env to git.
# =============================================================================

PORT=3000
NODE_ENV=development

# Clerk Auth (https://dashboard.clerk.com → API Keys)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/surestep

# Redis
REDIS_URL=redis://localhost:6379

# AWS S3 (or MinIO for local dev)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-south-1
AWS_S3_BUCKET=surestep-media

# Firebase FCM
FIREBASE_PROJECT_ID=...
FIREBASE_CLIENT_EMAIL=...
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Maps
GOOGLE_MAPS_API_KEY=...

# Anthropic Claude (Phase 2)
ANTHROPIC_API_KEY=...

# ElevenLabs Voice Cloning (Phase 2)
ELEVENLABS_API_KEY=...

# Razorpay Payments (Phase 2)
RAZORPAY_KEY_ID=...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
